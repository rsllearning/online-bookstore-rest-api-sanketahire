{
  "info": {
    "name": "Online Bookstore REST API",
    "description": "Postman Collection for Online Bookstore RESTful API Assignment (Raja Software Labs)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Task 1 - Add to Cart Lifecycle",
      "item": [
        {
          "name": "POST /v1/cart/items (Add to Cart)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 1,\n  \"quantity\": 2\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/cart/items", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "cart", "items"] }
          }
        },
        {
          "name": "GET /v1/cart (View Cart Snapshot)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
            ],
            "url": { "raw": "http://localhost:8080/v1/cart", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "cart"] }
          }
        }
      ]
    },
    {
      "name": "Task 2 - Books Inventory Endpoints",
      "item": [
        {
          "name": "1. Fetch List of All Books",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/v1/books", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "books"] }
          }
        },
        {
          "name": "2. Fetch Book Details by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/v1/books/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "books", "1"] }
          }
        },
        {
          "name": "3. Add New Book to Inventory",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Designing Data-Intensive Applications 2nd Ed\",\n  \"author\": \"Martin Kleppmann\",\n  \"isbn\": \"978-1098119065\",\n  \"price\": 49.99,\n  \"stockQuantity\": 40,\n  \"category\": \"Distributed Systems\"\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/books", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "books"] }
          }
        },
        {
          "name": "4. Update Book Price",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 37.99\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/books/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "books", "1"] }
          }
        },
        {
          "name": "5. Delete Book Record",
          "request": {
            "method": "DELETE",
            "url": { "raw": "http://localhost:8080/v1/books/5", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "books", "5"] }
          }
        }
      ]
    },
    {
      "name": "Task 3 - Orders & Error Handling",
      "item": [
        {
          "name": "6. Place New Order - Success (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"usr_1001\",\n  \"items\": [\n    {\n      \"bookId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"bookId\": 4,\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"456 Tech Park Way, Floor 4\",\n    \"city\": \"Pune\",\n    \"state\": \"Maharashtra\",\n    \"postalCode\": \"411057\",\n    \"country\": \"India\"\n  },\n  \"paymentMethodId\": \"pm_card_visa_4242\"\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/orders", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "orders"] }
          }
        },
        {
          "name": "Place New Order - Error (422 Insufficient Stock)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"usr_1001\",\n  \"items\": [\n    {\n      \"bookId\": 4,\n      \"quantity\": 10\n    }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"456 Tech Park Way\",\n    \"city\": \"Pune\",\n    \"state\": \"Maharashtra\",\n    \"postalCode\": \"411057\",\n    \"country\": \"India\"\n  }\n}"
            },
            "url": { "raw": "http://localhost:8080/v1/orders", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "orders"] }
          }
        },
        {
          "name": "7. Retrieve User Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/v1/users/usr_1001/orders", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["v1", "users", "usr_1001", "orders"] }
          }
        }
      ]
    }
  ]
}
